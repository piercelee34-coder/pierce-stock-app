# 重新命名為 .streamlit/secrets.toml 後使用
# Streamlit Cloud 部署：到 App Settings → Secrets 貼入下面內容

# 美股 NAAIM/AAII 第三層備援（Nasdaq Data Link 免費 API key）
# 註冊：https://data.nasdaq.com
NASDAQ_DATA_LINK_API_KEY = "貼你的_nasdaq_api_key"

# 台股空頭危機指數（FinMind 免費 token）
# 註冊：https://finmindtrade.com
FINMIND_TOKEN = "貼你的_finmind_token"
